# Sribees POS — Super Admin Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# 1. Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# 2. Local Vite Development Proxy Target (for `npm run dev`)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

VITE_DIRECT_API=false
